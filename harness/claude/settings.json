{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/qrspi-context.ts\" claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "EnterWorktree|ExitWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/qrspi-context.ts\" claude"
          }
        ]
      }
    ]
  }
}
